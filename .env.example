# Local UI mode. Production must leave this false.
DEMO_MODE=true

# Discord OAuth and bot application.
DISCORD_CLIENT_ID=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Generate a long random value before enabling Discord sign-in.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
INITIAL_ADMIN_DISCORD_ID=

# Optional external monitoring heartbeat used by the jobs Worker.
MONITOR_HEARTBEAT_URL=

# Deployment-only values. Keep these in GitHub environments, not this file.
CLOUDFLARE_D1_DATABASE_ID=
APP_URL=http://localhost:3000
