# Vite keeps this service credential on the development server; it is never
# bundled into browser JavaScript.
BOT_API_ORIGIN=https://boof-ban.fly.dev
# Optional local-only DNS override; normally leave this blank.
BOT_API_IP=
# At least 32 random bytes. It must match the bot's Web__ApiKey.
BOT_API_TOKEN=

# The guild ID is optional only when the bot is installed in exactly one
# server. The user ID is always required for local development so requests are
# authorized as a real Discord member.
BOT_DISCORD_GUILD_ID=
BOT_DISCORD_USER_ID=

# Required by deployed Workers. Local Vite development uses the safe owner
# fallback above and does not need these until you test the OAuth callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_SESSION_SECRET=
PUBLIC_ORIGIN=
