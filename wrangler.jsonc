{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rgboo-organizer",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "DISCORD_PUBLIC_KEY",
      "DISCORD_BOT_TOKEN",
    ],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
  },
  "vars": {
    "APP_ENV": "local",
    "DEMO_MODE": "true",
    "DISCORD_GUILD_ID": "",
    "DISCORD_APPLICATION_ID": "",
    "INITIAL_ADMIN_DISCORD_ID": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rgboo-organizer-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./drizzle",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "rgboo-organizer-staging",
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rgboo-organizer-staging",
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "./drizzle",
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        "DEMO_MODE": "false",
        "DISCORD_GUILD_ID": "",
        "DISCORD_APPLICATION_ID": "",
        "INITIAL_ADMIN_DISCORD_ID": "",
      },
    },
    "production": {
      "name": "rgboo-organizer",
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rgboo-organizer-production",
          "database_id": "22222222-2222-4222-8222-222222222222",
          "migrations_dir": "./drizzle",
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "DEMO_MODE": "false",
        "DISCORD_GUILD_ID": "",
        "DISCORD_APPLICATION_ID": "",
        "INITIAL_ADMIN_DISCORD_ID": "",
      },
    },
  },
}
