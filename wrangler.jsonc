{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rgboo-organizer",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-03",
  "secrets": {
    "required": [
      "AUTH_SESSION_SECRET",
      "BOT_API_ORIGIN",
      "BOT_API_TOKEN",
      "BOT_DISCORD_GUILD_ID",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "PUBLIC_ORIGIN",
    ],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "vars": {
    "APP_ENV": "local",
    "BOT_DISCORD_USER_ID": "",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "rgboo-organizer-staging",
      "secrets": {
        "required": [
          "AUTH_SESSION_SECRET",
          "BOT_API_ORIGIN",
          "BOT_API_TOKEN",
          "BOT_DISCORD_GUILD_ID",
          "DISCORD_CLIENT_ID",
          "DISCORD_CLIENT_SECRET",
          "PUBLIC_ORIGIN",
        ],
      },
      "vars": {
        "APP_ENV": "staging",
        "BOT_DISCORD_USER_ID": "",
      },
    },
    "production": {
      "name": "rgboo-organizer",
      "routes": [{ "pattern": "plan.rgboo.com", "custom_domain": true }],
      "secrets": {
        "required": [
          "AUTH_SESSION_SECRET",
          "BOT_API_ORIGIN",
          "BOT_API_TOKEN",
          "BOT_DISCORD_GUILD_ID",
          "DISCORD_CLIENT_ID",
          "DISCORD_CLIENT_SECRET",
          "PUBLIC_ORIGIN",
        ],
      },
      "vars": {
        "APP_ENV": "production",
        "BOT_DISCORD_USER_ID": "",
      },
    },
  },
}
